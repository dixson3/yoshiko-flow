
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Claude Code agent worktrees (ephemeral, per-agent isolated copies)
.claude/worktrees/

# Python bytecode cache
__pycache__/
*.pyc

# Rust / Cargo build artifacts (yf workspace)
/target/

# Skill runtime state + local config (never committed; per Skill Surface Convention)
/.yf/
# ...with ONE carve-out (REQ-YF-PRE-004a): the COMMITTED shared config tier
# `.yf/<short>/config.json`. Everything else under /.yf/ — all runtime state and
# every *.local.json — stays ignored. Git will not descend into an ignored
# directory, so the two `!` directory lines are required before the file rule.
!/.yf/
!/.yf/*/
/.yf/*/*
!/.yf/*/config.json
/.yf-plan.local.json
/.yf-research.local.json
/.agent-shell/

/.worktrees/

# Skill runtime state + local config (bdplan; Surface Convention §6)
/.bdplan.local.json
/.state/

# Skill runtime state + local config (yf-beads-init; Surface Convention §6)
/.yf-beads-init.local.json

# Skill runtime state + local config (yf-plan; Surface Convention §6)
/.beads/formulas/

# beads-init: required exclusions
.beads/proxieddb/
