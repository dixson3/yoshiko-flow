# FORMULA `plan-review` — yf-plan's Phase-3 wisp: ONE review cycle.
# Source of truth: skills/yf-plan/formulas/plan-review.formula.toml
# type: workflow · phase: VAPOR · [compose] aspects = ["verify-artifact"]
direction: right

meta: {
  label: "plan-review\ntype: workflow · phase: VAPOR\nONE cycle: conformance → red-team → resolve → gate"
  shape: rectangle
  style.fill: "#eef2ff"
}

chain: {
  label: "THE CHAIN — and the order is not incidental.\nEach pass verifies the PREVIOUS pass's resolutions."
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  conformance: {
    label: "step: conformance\ntype: task\ndispatch agents/reviewer.md\nPASS | INCOMPLETE\nproduces NO pass-N.md"
    shape: rectangle
  }
  redteam: {
    label: "step: red-team\ntype: task · needs: [conformance]\nDISPATCH agents/red-team.md AS A SUB-AGENT\nnever in the main session\nAPPROVE | REVISE | INVESTIGATE-MORE"
    shape: rectangle
    style.fill: "#ede9fe"
  }
  resolve: {
    label: "step: resolve\ntype: task · needs: [red-team]\nthe MAIN SESSION resolves and writes\nreviews/pass-N.md + the log.md review-pass: bullet"
    shape: rectangle
  }
  gate: {
    label: "step: gate\ntype: GATE · gate.type: human\nneeds: [resolve]"
    shape: hexagon
    style.fill: "#fef9c3"
  }
  conformance -> redteam: "PASS"
  redteam -> resolve
  resolve -> gate
}

aspect: {
  label: "ASPECT `verify-artifact`\nwoven at COOK time onto EVERY declared step\n→ <step.id>-verify"
  shape: rectangle
  style.fill: "#ecfeff"
  style.stroke: "#0e7490"
  style.stroke-dash: 3
}

nogoals: {
  label: "DECLARED NON-GOALS, recorded so a later cycle does not 'simplify' them in:\n\n· NO PARALLEL LENSES. The fan-out is BUILDABLE (`needs` is an array, multi-parent\n  fan-in is first-class) and is DECLINED for lack of evidence: 29 review passes\n  across four plans, all sequential, one reviewer each.\n· THE CYCLE COUNTER STAYS IN FILES. A wisp is ephemeral and BURNABLE, so a counter\n  inside one would be RESETTABLE by `bd mol burn` — restoring exactly the unbounded\n  self-resolving loop the bound exists to forbid.\n  The bound is len(glob('reviews/pass-*.md')), monotonic."
  shape: rectangle
  style.fill: "#fff7ed"
  style.stroke: "#c2410c"
  near: bottom-center
}

meta -> chain: "bd mol wisp plan-review"
aspect -> chain.conformance: "weaves" { style.stroke-dash: 3 }
aspect -> chain.redteam: "weaves" { style.stroke-dash: 3 }
aspect -> chain.resolve: "weaves" { style.stroke-dash: 3 }
aspect -> chain.gate: "weaves" { style.stroke-dash: 3 }
