# FORMULA `plan-execute` — yf-plan's Phase-5 pour.
# Source of truth: skills/yf-plan/formulas/plan-execute.formula.toml
# type: workflow · phase: LIQUID (a pour — durable, resumable, never burned)
direction: down

meta: {
  label: "plan-execute"
  type_workflow_phase_liquid: "type: workflow · phase: liquid"
  vars_objective_plan_dir: "vars: objective, plan_dir"
  owner_skills_yf_plan_formula: "owner: skills/yf-plan/formulas/"
  shape: rectangle
  style.fill: "#eef2ff"
  near: top-left
}

declared: {
  label: "DECLARED IN THE .formula.toml — one step"
  style.fill: "#f8fafc"
  style.stroke: "#64748b"

  gatestep: {
    label: "step id: start-gate"
    type_gate_gate_type_human: "type: GATE · gate.type: human"
    approvers_operator: "approvers: [operator]"
    shape: hexagon
    style.fill: "#fef9c3"
  }
  wrapper: {
    label: "plan-execute.start-gate"
    a_task_wrapper: "a TASK wrapper"
    what_downstream_deps_referen: "← what downstream --deps reference"
    shape: rectangle
    style.fill: "#e0f2fe"
  }
  gate: {
    label: "plan-execute.gate-start-gate"
    the_real_gate: "the REAL gate"
    what_bd_gate_resolve_targets: "← what `bd gate resolve` targets"
    shape: hexagon
    style.fill: "#fef9c3"
  }
  gatestep -> wrapper: "a gate step yields TWO beads"
  gatestep -> gate: "a gate step yields TWO beads"
}

injected: {
  label: "INJECTED AT EXECUTE START, from plan.md"
  not_declared_in_the_formula_: "(NOT declared in the formula — this is why the file is short)"
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"
  style.stroke-dash: 2

  epics: {
    label: "child EPICS"
    parent_only_never_deps_on_th: "--parent only, NEVER --deps on the wrapper"
    bd_rejects_a_task_blocking_a: "(bd rejects a task blocking an epic)"
    shape: rectangle
  }
  entry: {
    label: "ENTRY issues"
    no_intra_plan_predecessor: "no intra-plan predecessor"
    deps_start_gate_wrapper: "--deps <start-gate wrapper>"
    shape: rectangle
  }
  down: {
    label: "DOWNSTREAM issues"
    deps_predecessors_only: "--deps <predecessors> only;"
    the_gate_is_inherited_transi: "the gate is inherited TRANSITIVELY"
    shape: rectangle
  }
  capgates: {
    label: "CAPABILITY GATES"
    t_gate_metadata_carries: "-t gate · metadata carries"
    gate_type_test_test_class_cw: "gate_type / test / test_class / cwd"
    shape: hexagon
    style.fill: "#fef9c3"
  }
  recon: {
    label: "RECONCILE gate + step"
    only_when_an_upstream_issue: "only when an upstream issue"
    is_incorporated: "is incorporated"
    shape: rectangle
  }
  epics -> entry: "parent"
  entry -> down: "predecessor"
  down -> recon: "all execution beads closed"
  capgates -> down: "blocks" { style.stroke-dash: 3 }
}

resolve: {
  label: "resolve-start-gate"
  one_step_resolves_the_gate_a: "ONE step: resolves the gate AND closes the wrapper,"
  with_a_generated_close_reaso: "with a GENERATED close_reason."
  hand_running_bd_gate_resolve: "Hand-running `bd gate resolve` leaves the wrapper open —"
  the_state_close_cascade_py_c: "the state close_cascade.py correctly fail-louds on."
  shape: rectangle
  style.fill: "#dcfce7"
  style.stroke: "#15803d"
}

meta -> declared: "bd mol pour plan-execute"
declared.wrapper -> injected.entry: "--deps"
declared.gate -> resolve: "new session only"
resolve -> injected.epics: "status: executing"
