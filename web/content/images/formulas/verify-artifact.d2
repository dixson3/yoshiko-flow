# FORMULA `verify-artifact` — an ASPECT, not a workflow.
# Source of truth: skills/yf-plan/formulas/verify-artifact.formula.toml
# type: ASPECT — it declares no pipeline of its own; it ATTACHES to one.
direction: down

meta: {
  label: "verify-artifact\ntype: ASPECT (the only one shipped)\n\nWhy it exists: a review step that REPORTS a verdict and a review\nstep that WROTE the file carrying it are DIFFERENT FACTS —\nand only the second is checkable after the session ends."
  shape: rectangle
  style.fill: "#eef2ff"
}

template: {
  label: "THE WOVEN STEP TEMPLATE\nid: {step.id}-verify\ntitle: \"Verify artifact: {step.id}\"\ntype: task"
  shape: rectangle
  style.fill: "#ecfeff"
  style.stroke: "#0e7490"
}

attach: {
  label: "ATTACHMENT — `[compose] aspects` IN THE CONSUMER"
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  right: {
    label: "✓ [compose]\n  aspects = [\"verify-artifact\"]"
    shape: rectangle
    style.fill: "#dcfce7"
    style.stroke: "#15803d"
  }
  wrong: {
    label: "✗ a TOP-LEVEL aspects = [...]\nIS SILENTLY IGNORED:\nit parses, it cooks, and it composes NOTHING —\nso the obligation looks attached and is not"
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#b91c1c"
  }
}

weave: {
  label: "WEAVES AT **COOK** TIME,\nover FORMULA-DECLARED steps only\n(not over dynamically injected beads)"
  shape: rectangle
  style.fill: "#f5f3ff"
}

observe: {
  label: "WHERE TO OBSERVE IT — and where NOT to\n\n✓ bd cook <formula> --dry-run   → shows the WOVEN plan\n✗ bd formula show               → renders the RAW formula; NO woven steps, correctly\n✗ a pour of an UNCOOKED proto   → no woven steps, correctly\n\nMeasured on bd 1.1.2: checking either ✗ surface and concluding the aspect\ndoes not weave is a READING ERROR, not a bd defect."
  shape: rectangle
  style.fill: "#fff7ed"
  style.stroke: "#c2410c"
}

consumer: {
  label: "CONSUMER: plan-review\n(conformance · red-team · resolve · gate)"
  shape: rectangle
  style.fill: "#ede9fe"
}

meta -> template
meta -> attach
attach.right -> weave: "composes"
attach.wrong -> weave: "composes NOTHING" { style.stroke-dash: 4; style.stroke: "#b91c1c" }
weave -> consumer: "one <step.id>-verify per declared step"
weave -> observe
