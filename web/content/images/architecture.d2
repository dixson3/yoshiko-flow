# yoshiko-flow architecture — the yf kernel, embedded skills, beads, upstream tracking.
direction: right

user: {
  label: "operator\n(Claude Code / agent harness)"
  shape: person
}

yf: {
  label: "yf CLI\n(single Rust binary)"
  shape: rectangle
  install: "skills install / upgrade / remove"
  preflight: "preflight <skill>\n(shared kernel gate)"
  doctor: "doctor\n(env + install health)"
}

skills: {
  label: "embedded skills (20)\ncompiled into the binary"
  shape: rectangle
  workflows: "workflows group (3)\nplan · research · incubator"
  beads: "beads group (5)\nbeads-init · beads-extra\nbeads-authoring · beads-hygiene\nbeads-upstream"
  utility: "utility group (8)\nskill-authoring · drift-check\ndiagram-authoring · okf\nokf-hygiene · optimal-instructions\nchange-validation · herdr"
  markdown: "markdown group (4)\nmarkdown-lint · markdown-format\nmarkdown-pdf · markdown-html"
}

harness: {
  label: "harness surface\n~/.claude or ~/.agents\n(user or project scope)"
  shape: rectangle
}

bd: {
  label: "beads (bd)\nDolt-backed issue DB"
  shape: cylinder
}

upstream: {
  label: "upstream tracker\nGitHub Issues (via gh)"
  shape: rectangle
}

user -> yf: "invoke"
yf.install -> skills: "embeds"
yf.install -> harness: "deploys skills + rules"
user -> harness: "/yf-plan, /yf-research, ..."
harness -> yf.preflight: "gate before run"
skills.beads -> bd: "track work"
bd -> upstream: "land-the-plane push\n(open + deferred beads)"
