direction: right

spec: "Epic 0 — SPEC first" {
  embed7: "REQ-YF-EMBED-007\nfield limits"
  sk61: "REQ-SKAUTH-061\n4-state rating"
  sk62: "REQ-SKAUTH-062\neval contract"
  eng11: "REQ-ENGINE-011\nexit 4 · stream"
}

gate: "Epic 1 — hard gate + cap trims" {
  chk: "check_frontmatter.py ≤1024\n+ 5 mechanical trims\n(one change-set)"
  neg: "negative controls"
  chk -> neg
}

evals: "Epic 2 — eval harness" {
  eng: "change_validation.py\nexit 4 → inconclusive"
  run: "skill_trigger_eval.py\ncandidate | installed"
  fx: "fixtures (no live model)"
  intents: "skills/*/evals/triggers.json"
  full: "FULL row, last, streamed\ncandidate mode · all skills\nregression + confirm"
  run -> fx
  eng -> full
  run -> full
  intents -> full
}

trim: "Epic 3 — trim + rate" {
  lever: "wording-lever check"
  base: "baseline --record"
  loop: "scoped trim / re-rate\nUSD 200 ceiling → ask"
  final: "final --record\nratings-final.md"
  lever -> base -> loop -> final
}

split: "Epic 4 — split proposals" {
  prop: "not-crisp / unrouted"
  hg: "human gate" {shape: diamond}
  prop -> hg
  hg -> "follow-on plan": approve
  hg -> "satisfactory\n(+ accepted misses)": decline
}

land: "Epic 5 — guidance + land" {
  guide: "yf-skill-authoring\nguidance"
  deploy: "redeploy from main"
  verify: "installed mode · pi clean\nCC under listing budget"
  guide -> deploy -> verify
}

spec.embed7 -> gate.chk
spec.eng11 -> evals.eng
spec.sk62 -> evals.run
spec.sk62 -> evals.intents
spec.sk61 -> land.guide
gate.chk -> trim.base
evals.run -> trim.lever
evals.intents -> trim.lever
trim.final -> split.prop
trim.final -> land.guide
evals.full -> land.deploy
